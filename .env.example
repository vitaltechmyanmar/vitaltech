# Resend API key used by the contact form endpoint (/api/contact).
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown on enquiry emails. The domain must be verified in Resend.
# Until a domain is verified you can use: Vital Tech Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL="Vital Tech Website <onboarding@resend.dev>"

# Where enquiries are delivered. Defaults to the approved contact address in src/content/site.ts.
CONTACT_TO_EMAIL=info@vitaltechmyanmar.com

PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
