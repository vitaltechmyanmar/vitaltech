---
import CallToAction from '../components/CallToAction.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { pageMetadata } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const hero = {
  eyebrow: 'About Vital Tech Myanmar',
  outline: 'PRACTICAL',
  title: 'PARTNERSHIP',
  summary: 'We help teams make better technology decisions and turn them into delivery that supports real business progress.',
};
---

<BaseLayout metadata={pageMetadata['/about']} pathname="/about">
  <PageHero hero={hero} compact />

  <section class="section-frame grid gap-14 py-24 md:py-32 lg:grid-cols-[1fr_1fr]">
    <SectionHeading eyebrow="Our approach" title="Clear thinking. Strong delivery. Useful technology." summary="Vital Tech Myanmar brings together technical capability and business context so organizations can focus effort where it creates the most value." />
    <div class="grid gap-4">
      <article class="editorial-card p-7"><p class="eyebrow">01</p><h2 class="mt-4 text-2xl font-black text-ink">Understand the operating reality</h2><p class="mt-3 text-sm leading-7 text-muted">We start with the systems, people, constraints, and outcomes that shape the work.</p></article>
      <article class="editorial-card p-7"><p class="eyebrow">02</p><h2 class="mt-4 text-2xl font-black text-ink">Build for useful progress</h2><p class="mt-3 text-sm leading-7 text-muted">We favor clear, maintainable solutions over complexity that looks impressive but slows teams down.</p></article>
      <article class="editorial-card p-7"><p class="eyebrow">03</p><h2 class="mt-4 text-2xl font-black text-ink">Support the next stage</h2><p class="mt-3 text-sm leading-7 text-muted">We create foundations that can adapt as business needs, platforms, and delivery maturity evolve.</p></article>
    </div>
  </section>

  <CallToAction context="about" title="A technology partner for the work ahead." summary="Bring us the challenge, the opportunity, or the idea that needs a more practical technology path." />
</BaseLayout>
