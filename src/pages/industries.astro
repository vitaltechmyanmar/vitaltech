---
import Badge from '../components/ui/Badge.astro';
import CallToAction from '../components/CallToAction.astro';
import Card from '../components/ui/Card.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { industries, industriesPageContent, pageMetadata } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout metadata={pageMetadata['/industries']} pathname="/industries">
  <PageHero hero={industriesPageContent.hero} compact />

  <section class="section-frame py-24 md:py-32">
    <SectionHeading
      eyebrow={industriesPageContent.section.eyebrow}
      title={industriesPageContent.section.title}
      summary={industriesPageContent.section.summary}
    />
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        industries.map((industry) => (
          <Card as="article" padding="lg" interactive class="flex flex-col justify-between">
            <div>
              <h2 class="text-2xl font-black tracking-[-0.04em] text-ink">{industry.title}</h2>
              <p class="mt-4 text-sm leading-7 text-muted">{industry.summary}</p>
              <ul class="mt-7 flex flex-wrap gap-2">
                {industry.capabilities.map((capability) => <li><Badge tone="accent">{capability}</Badge></li>)}
              </ul>
            </div>
            <div class="mt-8 pt-4 border-t border-line/60">
              <a href={`/industries/${industry.id}`} class="inline-flex items-center text-xs font-black tracking-[0.1em] text-accent uppercase transition hover:text-accent-hover">
                Explore playbook <span aria-hidden="true" class="ml-2">→</span>
              </a>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="section-frame pb-24 md:pb-32">
    <Card variant="empty" padding="none" class="p-8 md:p-12">
      <p class="eyebrow">{industriesPageContent.evidence.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-black tracking-[-0.05em] text-ink">{industriesPageContent.evidence.title}</h2>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-muted">{industriesPageContent.evidence.summary}</p>
    </Card>
  </section>

  <CallToAction context="industries" title="Find a technology path that fits your context." summary="Use a direct conversation to explore the systems, delivery practices, and priorities that matter to your organization." />
</BaseLayout>
