---
import CallToAction from '../components/CallToAction.astro';
import PageHero from '../components/PageHero.astro';
import TechnologyEcosystem from '../components/TechnologyEcosystem.astro';
import { pageMetadata, services } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const hero = {
  eyebrow: 'Our services',
  outline: 'BUILT FOR',
  title: 'MOMENTUM',
  summary: 'Explore the capabilities that help organizations modernize the way they build, connect, operate, and grow.',
};
---

<BaseLayout metadata={pageMetadata['/services']} pathname="/services">
  <PageHero hero={hero} compact />

  <section class="section-frame pb-12">
    <nav class="flex flex-wrap gap-2 border-y border-line py-5" aria-label="Service sections">
      {services.map((service) => <a href={`#${service.id}`} class="nav-link border border-line bg-panel px-3 py-2 hover:border-ember" data-testid={`service-nav-${service.id}-link`}>{service.title}</a>)}
    </nav>
  </section>

  <section class="section-frame pb-24 md:pb-32">
    <div class="divide-y divide-line border-y border-line">
      {
        services.map((service, index) => (
          <article id={service.id} class="grid scroll-mt-8 gap-8 py-12 lg:grid-cols-[0.22fr_0.78fr] lg:py-16">
            <div>
              <p class="text-sm font-black tracking-[0.14em] text-ember uppercase">0{index + 1}</p>
              <p class="mt-4 text-xs font-bold tracking-[0.1em] text-muted uppercase">{service.kicker}</p>
            </div>
            <div>
              <h2 class="text-3xl font-black tracking-[-0.05em] text-ink md:text-5xl">{service.title}</h2>
              <p class="mt-5 max-w-2xl text-base leading-8 text-muted">{service.summary}</p>
              <p class="mt-6 border-l-2 border-ember pl-4 text-sm font-semibold leading-7 text-cobalt-dark">{service.outcome}</p>
              <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                {service.capabilities.map((capability) => <li class="editorial-card-muted px-4 py-3 text-sm text-ink">{capability}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <TechnologyEcosystem />

  <CallToAction context="services" title="Bring the right technology capabilities together." summary="Talk through your software, cloud, DevOps, integration, or managed IT challenge with our team." />
</BaseLayout>
