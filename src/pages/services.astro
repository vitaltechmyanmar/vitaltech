---
import ArchitectureBlueprint from '../components/ArchitectureBlueprint.astro';
import CallToAction from '../components/CallToAction.astro';
import CloudRoiCalculator from '../components/CloudRoiCalculator.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TechnologyEcosystem from '../components/TechnologyEcosystem.astro';
import { pageMetadata, services, servicesPageContent } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout metadata={pageMetadata['/services']} pathname="/services">
  <PageHero hero={servicesPageContent.hero} compact />

  <section class="section-frame py-24 md:py-32">
    <SectionHeading
      eyebrow={servicesPageContent.section.eyebrow}
      title={servicesPageContent.section.title}
      summary={servicesPageContent.section.summary}
    />
    <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {services.map((service, index) => <ServiceCard service={service} index={index} />)}
    </div>
  </section>

  <ArchitectureBlueprint />

  <CloudRoiCalculator />

  <TechnologyEcosystem />

  <CallToAction
    context="services"
    title="Bring the right technology capabilities together."
    summary="Talk through your cloud, delivery automation, integration, or DevOps challenge with our team."
  />
</BaseLayout>
