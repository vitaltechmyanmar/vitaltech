---
import Card from '../components/ui/Card.astro';
import ContactActions from '../components/ContactActions.astro';
import ContactForm from '../components/ContactForm.astro';
import PageHero from '../components/PageHero.astro';
import { contactPageContent, pageMetadata } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout metadata={pageMetadata['/contact']} pathname="/contact">
  <PageHero hero={contactPageContent.hero} compact />

  <section class="section-frame grid gap-12 pb-24 md:pb-32 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow">{contactPageContent.intro.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-black tracking-[-0.05em] text-ink">{contactPageContent.intro.title}</h2>
      <p class="mt-5 max-w-xl text-base leading-8 text-muted">{contactPageContent.intro.summary}</p>
      <Card variant="accent" padding="lg" class="mt-8">
        <ContactActions context="contact-page" variant="stacked" />
      </Card>
    </div>
    <ContactForm />
  </section>
</BaseLayout>
