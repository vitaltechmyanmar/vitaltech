---
import ContactActions from '../components/ContactActions.astro';
import PageHero from '../components/PageHero.astro';
import { careers, pageMetadata } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const hero = {
  eyebrow: 'Careers',
  outline: 'BUILDING',
  title: 'TOGETHER',
  summary: 'Join a team focused on creating useful technology outcomes for organizations that are ready to move forward.',
};
---

<BaseLayout metadata={pageMetadata['/careers']} pathname="/careers">
  <PageHero hero={hero} compact />

  <section class="section-frame grid gap-12 pb-24 md:pb-32 lg:grid-cols-[1fr_0.8fr]">
    <div>
      <p class="eyebrow">Why Vital Tech</p>
      <h2 class="mt-4 text-4xl font-black tracking-[-0.05em] text-white">Meaningful technology work starts with people who care about the outcome.</h2>
      <p class="mt-5 max-w-2xl text-base leading-8 text-white/65">We are building a team that values clear thinking, practical delivery, curiosity, and the confidence to improve how technology supports business.</p>
    </div>
    <div class="border border-white/10 bg-panel p-7">
      <p class="eyebrow">Opportunities</p>
      {
        careers.length ? (
          <ul class="mt-6 grid gap-4">{careers.map((career) => <li class="border border-white/10 p-4"><h3 class="font-black text-white">{career.title}</h3><p class="mt-2 text-xs text-lime uppercase">{career.location}</p><p class="mt-3 text-sm leading-6 text-white/60">{career.summary}</p></li>)}</ul>
        ) : (
          <p class="mt-5 text-sm leading-7 text-white/60">No public roles are listed right now. Use the approved direct-contact route when official application details are available.</p>
        )
      }
      <div class="mt-7"><ContactActions context="careers" variant="stacked" /></div>
    </div>
  </section>
</BaseLayout>
