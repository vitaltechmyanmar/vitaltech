---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { notFoundPageContent, pageMetadata } from '../content/site';
---

<BaseLayout metadata={pageMetadata['/404']} pathname="/404">
  <section class="section-frame py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent-soft px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent">
        <span class="inline-block size-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
        {notFoundPageContent.eyebrow}
      </div>

      <div class="mt-6 font-display text-7xl font-black tracking-tight text-ink md:text-9xl">
        <span class="bg-gradient-to-r from-accent to-blue-500 bg-clip-text text-transparent">
          {notFoundPageContent.code}
        </span>
      </div>

      <h1 class="mt-4 text-3xl font-black tracking-tight text-ink md:text-4xl">
        {notFoundPageContent.title}
      </h1>

      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted md:text-lg">
        {notFoundPageContent.summary}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button href={notFoundPageContent.primaryAction.href} variant="primary" size="md">
          {notFoundPageContent.primaryAction.label}
        </Button>
        <Button href={notFoundPageContent.secondaryAction.href} variant="secondary" size="md">
          {notFoundPageContent.secondaryAction.label}
        </Button>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface-muted py-20 md:py-24">
    <div class="section-frame">
      <SectionHeading
        eyebrow={notFoundPageContent.suggestedHeading.eyebrow}
        title={notFoundPageContent.suggestedHeading.title}
        summary={notFoundPageContent.suggestedHeading.summary}
      />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {notFoundPageContent.suggestedLinks.map((link) => (
          <Card as="a" href={link.href} padding="lg" interactive class="group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-accent">Navigation</span>
                <span class="text-muted transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent" aria-hidden="true">&rarr;</span>
              </div>
              <h2 class="mt-3 text-lg font-black tracking-tight text-ink transition-colors group-hover:text-accent">
                {link.label}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {link.description}
              </p>
            </div>
            <div class="mt-6 border-t border-line/60 pt-3 text-xs font-semibold text-accent">
              Explore path &rarr;
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
