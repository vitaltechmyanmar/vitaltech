---
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import CallToAction from '../../components/CallToAction.astro';
import Card from '../../components/ui/Card.astro';
import { insights } from '../../content/site';
import { getInsightMetadata, getInsightPath } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Insight } from '../../types/site';

export function getStaticPaths() {
  return insights.map((insight) => ({
    params: { slug: insight.slug },
    props: { insight },
  }));
}

interface Props {
  insight: Insight;
}

const { insight } = Astro.props;
const metadata = getInsightMetadata(insight);
const pathname = getInsightPath(insight);

const relatedInsights = insights
  .filter((item) => item.slug !== insight.slug)
  .slice(0, 2);
---

<BaseLayout metadata={metadata} pathname={pathname}>
  {/* Article Header */}
  <header class="relative overflow-hidden py-16 md:py-24 border-b border-line">
    <div class="ambient-orb -top-40 left-[25%]"></div>
    <div class="section-frame relative max-w-4xl">
      <a
        href="/insights"
        class="inline-flex items-center text-xs font-black uppercase tracking-[0.1em] text-accent transition hover:text-accent-hover"
      >
        <span aria-hidden="true" class="mr-2">←</span> All insights
      </a>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Badge tone="accent">{insight.category}</Badge>
        <span class="text-xs font-semibold text-muted tracking-wider uppercase">{insight.readTime}</span>
      </div>

      <h1 class="mt-6 text-3xl font-black tracking-[-0.04em] text-ink sm:text-5xl lg:text-6xl leading-[1.1]">
        {insight.title}
      </h1>

      <p class="mt-6 text-lg sm:text-xl leading-relaxed text-muted font-normal max-w-3xl">
        {insight.summary}
      </p>
    </div>
  </header>

  {/* Article Body */}
  <article class="section-frame py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <div class="space-y-6 text-base sm:text-lg leading-8 text-ink/90">
        {insight.body.map((paragraph, index) => (
          <p class={index === 0 ? 'text-lg sm:text-xl font-medium text-ink leading-relaxed' : ''}>
            {paragraph}
          </p>
        ))}
      </div>

      {/* Article Takeaway Card */}
      <Card variant="muted" padding="lg" class="mt-16 border-line">
        <p class="eyebrow">Practical takeaway</p>
        <h3 class="mt-2 text-xl font-black tracking-tight text-ink">
          Operational discipline outlasts ad-hoc tooling.
        </h3>
        <p class="mt-3 text-sm leading-7 text-muted">
          Whether organizing cloud infrastructure, establishing CI/CD pipelines, or standardizing repository governance, sustainable progress starts with clear boundaries, measurable metrics, and team ownership.
        </p>
        <div class="mt-6">
          <Button href="/contact" variant="primary">Discuss this topic with our team</Button>
        </div>
      </Card>
    </div>
  </article>

  {/* Related Insights */}
  {relatedInsights.length > 0 && (
    <section class="border-t border-line bg-surface-muted py-16 md:py-24">
      <div class="section-frame max-w-4xl">
        <p class="eyebrow">Continue reading</p>
        <h2 class="mt-2 text-2xl font-black tracking-tight text-ink sm:text-3xl">
          More technical perspectives
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {relatedInsights.map((item) => (
            <Card as="article" padding="md" interactive class="flex flex-col justify-between">
              <div>
                <p class="eyebrow">{item.category}</p>
                <h3 class="mt-2 text-lg font-black tracking-tight text-ink">{item.title}</h3>
                <p class="mt-3 text-sm leading-6 text-muted">{item.summary}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-line/60">
                <a
                  href={`/insights/${item.slug}`}
                  class="inline-flex items-center text-xs font-black tracking-[0.1em] text-accent uppercase transition hover:text-accent-hover"
                >
                  Read article <span aria-hidden="true" class="ml-2">→</span>
                </a>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  <CallToAction
    context="insights"
    title="Ready to turn technical insight into delivery momentum?"
    summary="Connect directly with our engineering team to review your architecture, deployment pipelines, and cloud operations."
  />
</BaseLayout>
