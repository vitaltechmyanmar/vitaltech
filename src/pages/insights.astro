---
import PageHero from '../components/PageHero.astro';
import { insights, pageMetadata } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const hero = {
  eyebrow: 'Insights',
  outline: 'THINKING',
  title: 'FORWARD',
  summary: 'Perspectives on the systems, delivery practices, and technology choices that create practical momentum.',
};
---

<BaseLayout metadata={pageMetadata['/insights']} pathname="/insights">
  <PageHero hero={hero} compact />

  <section class="section-frame pb-24 md:pb-32">
    {
      insights.length ? (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {insights.map((insight) => <article class="editorial-card p-6"><p class="eyebrow">{insight.category}</p><h2 class="mt-6 text-2xl font-black text-ink">{insight.title}</h2><p class="mt-3 text-sm leading-7 text-muted">{insight.summary}</p>{insight.href && <a href={insight.href} class="mt-6 inline-flex text-xs font-black tracking-[0.1em] text-ember uppercase">Read insight ↗</a>}</article>)}
        </div>
      ) : (
        <div class="editorial-empty-state p-8 md:p-12">
          <p class="eyebrow">Insights in preparation</p>
          <h2 class="mt-4 text-3xl font-black tracking-[-0.05em] text-ink">Our first published perspectives are being prepared.</h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-muted">Check back for practical thinking on software, cloud, DevOps, system integration, and technology operations.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
