---
import Card from '../components/ui/Card.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { insights, insightsPageContent, pageMetadata } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout metadata={pageMetadata['/insights']} pathname="/insights">
  <PageHero hero={insightsPageContent.hero} compact />

  <section class="section-frame pb-24 md:pb-32">
    {
      insights.length ? (
        <>
          <SectionHeading
            eyebrow="Perspectives"
            title="Practical thinking for cloud, delivery, and operations."
            summary="Explore topics that shape reliable infrastructure, predictable software delivery, and better-connected systems."
          />
          <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {insights.map((insight) => (
              <Card as="article" padding="lg" interactive class="flex h-full flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between text-xs">
                    <p class="eyebrow">{insight.category}</p>
                    <span class="text-muted font-medium">{insight.readTime}</span>
                  </div>
                  <h2 class="mt-5 text-xl font-black tracking-[-0.03em] text-ink sm:text-2xl">{insight.title}</h2>
                  <p class="mt-4 text-sm leading-7 text-muted">{insight.summary}</p>
                </div>
                <div class="mt-8 pt-4 border-t border-line/60">
                  <a href={`/insights/${insight.slug}`} class="inline-flex items-center text-xs font-black tracking-[0.1em] text-accent uppercase transition hover:text-accent-hover">
                    Read article <span aria-hidden="true" class="ml-2">→</span>
                  </a>
                </div>
              </Card>
            ))}
          </div>
        </>
      ) : (
        <Card variant="empty" padding="none" class="p-8 md:p-12">
          <p class="eyebrow">Insights in preparation</p>
          <h2 class="mt-4 text-3xl font-black tracking-[-0.05em] text-ink">Our first published perspectives are being prepared.</h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-muted">Check back for practical thinking on cloud operations, delivery automation, infrastructure as code, and system integration.</p>
        </Card>
      )
    }
  </section>
</BaseLayout>
