---
import ContactActions from './ContactActions.astro';
import { navigation, siteName } from '../content/site';
---

<footer class="border-t border-inverse-line bg-inverse-surface py-14 text-inverse-ink">
  <div class="section-frame grid gap-12 lg:grid-cols-[1.1fr_1fr_1fr]">
    <div>
      <p class="eyebrow text-focus-inverse">Vital Tech Myanmar</p>
      <h2 class="mt-4 max-w-sm text-3xl font-black tracking-[-0.05em] text-inverse-ink">Technology that creates practical momentum.</h2>
      <p class="mt-5 max-w-md text-sm leading-7 text-inverse-muted">
        Cloud managed services, delivery automation, system integration, and DevOps consulting for ambitious organizations.
      </p>
    </div>
    <div>
      <p class="text-xs font-black tracking-[0.12em] text-focus-inverse uppercase">Explore</p>
      <ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-3">
        {navigation.map((item) => <li><a href={item.href} class="nav-link" data-tone="inverse" data-testid={`footer-nav-${item.label.toLowerCase()}-link`}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-xs font-black tracking-[0.12em] text-focus-inverse uppercase">Direct contact</p>
      <div class="mt-5"><ContactActions context="footer" variant="footer" tone="inverse" /></div>
    </div>
  </div>
  <div class="section-frame mt-12 border-t border-inverse-line pt-6 text-xs text-inverse-muted">
    © {new Date().getFullYear()} {siteName}. Built for the next stage of growth.
  </div>
</footer>
