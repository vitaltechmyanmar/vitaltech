---
import Badge from './ui/Badge.astro';
import Card from './ui/Card.astro';
import SectionHeading from './SectionHeading.astro';
import { blueprintContent, technologyStack } from '../content/site';
import type { TechnologyIcon } from '../types/site';

const iconByLabel = new Map(technologyStack.map((item) => [item.label, item]));
const getToolIcon = (name: string): TechnologyIcon | undefined => iconByLabel.get(name);
---

<section class="section-frame py-24 md:py-32" aria-labelledby="blueprint-heading">
  <SectionHeading
    id="blueprint-heading"
    eyebrow={blueprintContent.eyebrow}
    title={blueprintContent.title}
    summary={blueprintContent.summary}
  />

  <div class="blueprint-widget mt-12" data-blueprint-widget>
    {/* Stage Track / Tabs */}
    <div
      class="relative flex items-center justify-between gap-2 overflow-x-auto pb-4 pt-2 md:gap-4 md:overflow-visible"
      role="tablist"
      aria-label="Cloud Delivery Lifecycle Stages"
    >
      {/* Background connector line on desktop */}
      <div class="pointer-events-none absolute left-8 right-8 top-1/2 -z-0 hidden h-0.5 -translate-y-1/2 bg-line md:block" aria-hidden="true"></div>

      {
        blueprintContent.stages.map((stage, index) => {
          const isInitial = index === 0;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${stage.id}`}
              aria-controls={`panel-${stage.id}`}
              aria-selected={isInitial ? 'true' : 'false'}
              tabindex={isInitial ? 0 : -1}
              data-stage-index={index}
              class={`blueprint-tab group relative z-10 flex min-w-[140px] flex-1 flex-col items-center rounded-xl border px-3 py-3.5 text-center transition-all duration-200 sm:px-4 sm:py-4 ${
                isInitial
                  ? 'border-accent bg-accent text-white shadow-lg shadow-accent/20'
                  : 'border-line bg-surface text-ink hover:-translate-y-0.5 hover:border-accent hover:shadow-card'
              }`}
            >
              <span
                class={`blueprint-tab-step text-[0.68rem] font-black uppercase tracking-[0.1em] transition-colors ${
                  isInitial ? 'text-white/80' : 'text-accent'
                }`}
              >
                {stage.step} / {stage.kicker}
              </span>
              <span class="blueprint-tab-title mt-1.5 text-xs font-bold leading-tight sm:text-sm">
                {stage.title.split(' & ')[0]}
              </span>
            </button>
          );
        })
      }
    </div>

    {/* Stage Panels */}
    <div class="mt-8">
      {
        blueprintContent.stages.map((stage, index) => {
          const isInitial = index === 0;
          return (
            <div
              id={`panel-${stage.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${stage.id}`}
              class={`blueprint-panel transition-opacity duration-300 ${isInitial ? 'block' : 'hidden'}`}
              data-panel-id={stage.id}
            >
              <Card as="article" padding="lg" class="border-line bg-surface shadow-card">
                <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
                  {/* Left Column: Details & Verification Gates */}
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <Badge tone="accent">Stage {stage.step}</Badge>
                      <span class="text-xs font-bold uppercase tracking-widest text-muted">{stage.kicker}</span>
                    </div>

                    <h3 class="mt-4 text-2xl font-black tracking-[-0.03em] text-ink sm:text-3xl">
                      {stage.title}
                    </h3>
                    <p class="mt-4 text-sm leading-7 text-muted sm:text-base">
                      {stage.summary}
                    </p>

                    <div class="mt-8">
                      <h4 class="text-xs font-black uppercase tracking-[0.1em] text-ink">
                        Automated Verification Gates
                      </h4>
                      <ul class="mt-4 space-y-3" role="list">
                        {stage.gates.map((gate) => (
                          <li class="flex items-start gap-3 text-sm leading-6 text-muted">
                            <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-accent text-white" aria-hidden="true">
                              <svg class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                              </svg>
                            </span>
                            <span class="text-ink font-medium">{gate}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  {/* Right Column: Integrated Tooling & Outcome */}
                  <div class="flex flex-col gap-6 lg:border-l lg:border-line lg:pl-8">
                    {/* Engineered Outcome */}
                    <div class="rounded-xl border border-accent/25 bg-accent-soft/40 p-5">
                      <p class="text-[0.7rem] font-black uppercase tracking-[0.12em] text-accent">
                        Engineered Outcome
                      </p>
                      <p class="mt-2 text-sm font-semibold leading-6 text-ink">
                        {stage.outcome}
                      </p>
                    </div>

                    {/* Integrated Tooling */}
                    <div>
                      <p class="text-xs font-black uppercase tracking-[0.1em] text-ink">
                        Integrated Tooling & Platforms
                      </p>
                      <ul class="mt-4 flex flex-wrap gap-2.5" role="list">
                        {stage.tools.map((toolName) => {
                          const icon = getToolIcon(toolName);
                          return (
                            <li class="inline-flex items-center gap-2 rounded-lg border border-line bg-canvas px-3 py-2 text-xs font-bold text-ink shadow-sm transition hover:border-accent">
                              {icon && (
                                <img
                                  src={icon.iconPath}
                                  alt=""
                                  width="18"
                                  height="18"
                                  loading="lazy"
                                  decoding="async"
                                  class="h-4.5 w-4.5 object-contain"
                                />
                              )}
                              <span>{toolName}</span>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </div>
                </div>
              </Card>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  function initBlueprintWidgets() {
    const widgets = document.querySelectorAll<HTMLElement>('[data-blueprint-widget]');

    widgets.forEach((widget) => {
      const tabs = Array.from(widget.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(widget.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

      function activateTab(targetTab: HTMLButtonElement, shouldFocus = true) {
        tabs.forEach((tab) => {
          const isSelected = tab === targetTab;
          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          tab.tabIndex = isSelected ? 0 : -1;

          const stepEl = tab.querySelector<HTMLElement>('.blueprint-tab-step');

          if (isSelected) {
            tab.classList.remove('border-line', 'bg-surface', 'text-ink');
            tab.classList.add('border-accent', 'bg-accent', 'text-white', 'shadow-lg', 'shadow-accent/20');
            stepEl?.classList.remove('text-accent');
            stepEl?.classList.add('text-white/80');
          } else {
            tab.classList.remove('border-accent', 'bg-accent', 'text-white', 'shadow-lg', 'shadow-accent/20');
            tab.classList.add('border-line', 'bg-surface', 'text-ink');
            stepEl?.classList.remove('text-white/80');
            stepEl?.classList.add('text-accent');
          }
        });

        const targetPanelId = targetTab.getAttribute('aria-controls');
        panels.forEach((panel) => {
          if (panel.id === targetPanelId) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });

        if (shouldFocus) {
          targetTab.focus();
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateTab(tab, false));

        tab.addEventListener('keydown', (e) => {
          let nextIndex: number | null = null;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            nextIndex = (index + 1) % tabs.length;
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (e.key === 'Home') {
            nextIndex = 0;
          } else if (e.key === 'End') {
            nextIndex = tabs.length - 1;
          }

          if (nextIndex !== null) {
            e.preventDefault();
            activateTab(tabs[nextIndex], true);
          }
        });
      });
    });
  }

  // Initialize on page load and Astro view transitions if active
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlueprintWidgets, { once: true });
  } else {
    initBlueprintWidgets();
  }
</script>
