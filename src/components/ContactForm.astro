---
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import { contactForm } from '../content/site';

const { fields } = contactForm;

const labelClass = 'block text-xs font-black tracking-[0.08em] text-ink uppercase';
const fieldClass =
  'mt-2 w-full rounded-md border border-line bg-surface px-4 py-3 text-sm text-ink shadow-sm outline-none transition placeholder:text-muted/60 focus:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none';
const errorClass = 'mt-2 hidden text-xs font-semibold leading-5 text-red-700';
const optionalClass = 'ml-1 font-semibold tracking-normal text-muted normal-case';
---

<Card padding="lg" data-testid="contact-form-card">
  <p class="eyebrow">{contactForm.eyebrow}</p>
  <h2 id="contact-form-heading" class="mt-4 text-3xl font-black tracking-[-0.05em] text-ink md:text-4xl">
    {contactForm.title}
  </h2>
  <p class="mt-4 text-sm leading-7 text-muted">{contactForm.summary}</p>

  <form
    id="contact-form"
    class="relative mt-8"
    action="/api/contact"
    method="post"
    data-contact-form
    data-validation-message={contactForm.validationMessage}
    data-success-message={contactForm.successMessage}
    data-failure-message={contactForm.failureMessage}
    aria-labelledby="contact-form-heading"
  >
    <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="contact-name" class={labelClass}>
          {fields.name.label}<span class="ml-1 text-accent" aria-hidden="true">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          minlength="2"
          maxlength="100"
          autocomplete="name"
          placeholder={fields.name.placeholder}
          class={fieldClass}
          aria-describedby="contact-name-error"
          data-testid="contact-form-name"
        />
        <p id="contact-name-error" class={errorClass} data-error-for="name"></p>
      </div>

      <div>
        <label for="contact-email" class={labelClass}>
          {fields.email.label}<span class="ml-1 text-accent" aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          maxlength="254"
          inputmode="email"
          autocomplete="email"
          placeholder={fields.email.placeholder}
          class={fieldClass}
          aria-describedby="contact-email-error"
          data-testid="contact-form-email"
        />
        <p id="contact-email-error" class={errorClass} data-error-for="email"></p>
      </div>

      <div>
        <label for="contact-company" class={labelClass}>
          {fields.company.label}<span class={optionalClass}>(optional)</span>
        </label>
        <input
          id="contact-company"
          name="company"
          type="text"
          maxlength="120"
          autocomplete="organization"
          placeholder={fields.company.placeholder}
          class={fieldClass}
          aria-describedby="contact-company-error"
          data-testid="contact-form-company"
        />
        <p id="contact-company-error" class={errorClass} data-error-for="company"></p>
      </div>

      <div>
        <label for="contact-phone" class={labelClass}>
          {fields.phone.label}<span class={optionalClass}>(optional)</span>
        </label>
        <input
          id="contact-phone"
          name="phone"
          type="tel"
          maxlength="40"
          autocomplete="tel"
          placeholder={fields.phone.placeholder}
          class={fieldClass}
          aria-describedby="contact-phone-error"
          data-testid="contact-form-phone"
        />
        <p id="contact-phone-error" class={errorClass} data-error-for="phone"></p>
      </div>

      <div class="sm:col-span-2">
        <label for="contact-service" class={labelClass}>
          {fields.service.label}<span class={optionalClass}>(optional)</span>
        </label>
        <select
          id="contact-service"
          name="service"
          class={fieldClass}
          aria-describedby="contact-service-error"
          data-testid="contact-form-service"
        >
          <option value="" selected>{contactForm.servicePlaceholder}</option>
          {contactForm.serviceOptions.map((service) => <option value={service}>{service}</option>)}
        </select>
        <p id="contact-service-error" class={errorClass} data-error-for="service"></p>
      </div>

      <div class="sm:col-span-2">
        <label for="contact-message" class={labelClass}>
          {fields.message.label}<span class="ml-1 text-accent" aria-hidden="true">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows="5"
          minlength="10"
          maxlength="5000"
          placeholder={fields.message.placeholder}
          class={fieldClass}
          aria-describedby="contact-message-error"
          data-testid="contact-form-message"
        ></textarea>
        <p id="contact-message-error" class={errorClass} data-error-for="message"></p>
      </div>
    </div>

    <div
      data-contact-status
      data-success-message={contactForm.successMessage}
      data-failure-message={contactForm.failureMessage}
      role="status"
      aria-live="polite"
      tabindex="-1"
      hidden
      class="mt-6 rounded-md border border-line bg-surface-muted px-4 py-3 text-sm font-semibold text-ink data-[state=success]:border-emerald-300 data-[state=success]:bg-emerald-50 data-[state=success]:text-emerald-900 data-[state=error]:border-red-300 data-[state=error]:bg-red-50 data-[state=error]:text-red-800"
    >
    </div>

    <div class="mt-6 flex flex-col gap-5 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md text-xs leading-6 text-muted">
        <span class="font-bold text-ink">{contactForm.requiredNote}</span>
        {contactForm.privacyNote}
      </p>
      <Button
        type="submit"
        data-testid="contact-form-submit"
        data-label={contactForm.submitLabel}
        data-submitting-label={contactForm.submittingLabel}
      >
        {contactForm.submitLabel}
      </Button>
    </div>
  </form>
</Card>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = submit?.dataset.label ?? '';
    const submittingLabel = submit?.dataset.submittingLabel ?? '';

    const setBusy = (busy: boolean) => {
      if (!submit) return;
      submit.disabled = busy;
      submit.textContent = busy ? submittingLabel : submitLabel;
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((element) => {
        element.hidden = true;
        element.textContent = '';
      });
      form.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((element) => {
        element.removeAttribute('aria-invalid');
      });
    };

    const showStatus = (state: 'success' | 'error', message: string, focus = true) => {
      if (!status || !message) return;
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = false;
      if (focus) status.focus();
    };

    const showErrors = (errors: Record<string, string>) => {
      let firstInvalid: HTMLElement | null = null;

      for (const [field, message] of Object.entries(errors)) {
        const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        const input = form.elements.namedItem(field);

        if (error) {
          error.textContent = message;
          error.hidden = false;
        }

        if (input instanceof HTMLElement) {
          input.setAttribute('aria-invalid', 'true');
          firstInvalid ??= input;
        }
      }

      firstInvalid?.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit?.disabled) return;
      clearErrors();

      if (status) {
        status.hidden = true;
        status.textContent = '';
        delete status.dataset.state;
      }

      if (!form.reportValidity()) return;

      setBusy(true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const payload = (await response.json().catch(() => null)) as
          | { ok?: boolean; message?: string; errors?: Record<string, string> }
          | null;

        if (response.ok && payload?.ok) {
          form.reset();
          showStatus('success', payload.message ?? form.dataset.successMessage ?? '');
          return;
        }

        if (payload?.errors) {
          showErrors(payload.errors);
          showStatus('error', payload.message ?? form.dataset.validationMessage ?? '', false);
          return;
        }

        showStatus('error', payload?.message ?? form.dataset.failureMessage ?? '');
      } catch {
        showStatus('error', form.dataset.failureMessage ?? '');
      } finally {
        setBusy(false);
      }
    });
  }
</script>

<script is:inline>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const result = params.get('form');
    if (result !== 'sent' && result !== 'error') return;

    const status = document.querySelector('[data-contact-status]');
    if (!status) return;

    status.textContent = result === 'sent' ? status.dataset.successMessage : status.dataset.failureMessage;
    status.dataset.state = result === 'sent' ? 'success' : 'error';
    status.hidden = false;

    params.delete('form');
    const query = params.toString();
    window.history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}#contact-form`);
  })();
</script>
