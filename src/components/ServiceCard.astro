---
import Card from './ui/Card.astro';
import type { Service } from '../types/site';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
---

<Card as="article" interactive class="group flex h-full flex-col">
  <p class="text-xs font-black tracking-[0.12em] text-accent uppercase">0{index + 1}</p>
  <h3 class="mt-8 text-2xl font-black tracking-[-0.04em] text-ink">{service.title}</h3>
  <p class="mt-3 text-sm leading-7 text-muted">{service.summary}</p>
  <a href={`/services#${service.id}`} class="mt-auto inline-flex pt-7 text-xs font-black tracking-[0.1em] text-accent uppercase transition hover:text-accent-hover" data-testid={`service-card-${service.id}-link`}>
    Explore service <span aria-hidden="true" class="ml-2">↗</span>
  </a>
</Card>
