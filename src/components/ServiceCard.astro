---
import type { Service } from '../types/site';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
---

<article class="editorial-card group flex h-full flex-col p-6 transition duration-200 hover:-translate-y-1 hover:border-ember">
  <p class="text-xs font-black tracking-[0.12em] text-ember uppercase">0{index + 1}</p>
  <h3 class="mt-8 text-2xl font-black tracking-[-0.04em] text-ink">{service.title}</h3>
  <p class="mt-3 text-sm leading-7 text-muted">{service.summary}</p>
  <a href={`/services#${service.id}`} class="mt-7 inline-flex text-xs font-black tracking-[0.1em] text-ember uppercase" data-testid={`service-card-${service.id}-link`}>
    Explore service <span aria-hidden="true" class="ml-2">↗</span>
  </a>
</article>
