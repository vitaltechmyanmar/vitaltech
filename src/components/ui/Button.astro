---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse';
  size?: 'sm' | 'md';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props as Props;
const Tag = href ? 'a' : 'button';

const base =
  'inline-flex items-center justify-center gap-2 rounded-md border font-black uppercase tracking-[0.08em] transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none';

const variants = {
  primary:
    'border-accent bg-accent text-on-accent shadow-sm hover:-translate-y-0.5 hover:border-accent-hover hover:bg-accent-hover focus-visible:outline-accent',
  secondary:
    'border-line-strong bg-surface text-ink hover:-translate-y-0.5 hover:border-accent hover:bg-accent-soft hover:text-accent focus-visible:outline-accent',
  ghost:
    'border-transparent bg-transparent text-accent hover:bg-accent-soft focus-visible:outline-accent',
  inverse:
    'border-inverse-line bg-transparent text-inverse-ink hover:border-focus-inverse hover:bg-white/10 focus-visible:outline-focus-inverse',
};

const sizes = {
  sm: 'min-h-9 px-3 py-2 text-[0.68rem]',
  md: 'min-h-11 px-4 py-3 text-xs',
};

const classes = [base, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

<Tag class={classes} href={href} {...rest}>
  <slot />
</Tag>
