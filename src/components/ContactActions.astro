---
import { getContactChannels } from '../lib/site';

interface Props {
  context?: string;
  variant?: 'inline' | 'stacked' | 'footer';
}

const { context = 'global', variant = 'inline' } = Astro.props;
const channels = getContactChannels();
const layoutClass = variant === 'stacked' ? 'flex flex-col items-start gap-3' : 'flex flex-wrap gap-3';
---

<div class={layoutClass} aria-label="Direct contact options">
  {
    channels.map((channel) =>
      channel.links?.length ? (
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label={`${channel.label} contact options`}>
          <span class="text-xs font-black tracking-[0.1em] text-ink uppercase">{channel.label}</span>
          {
            channel.links.map((link, index) => (
              <a
                class="outline-button"
                href={link.href}
                data-testid={index === 0 ? `${context}-contact-${channel.id}-link` : `${context}-contact-${channel.id}-link-${index + 1}`}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      ) : (
        <span class="border border-line bg-white px-4 py-3 text-xs font-semibold tracking-[0.08em] text-muted uppercase" data-testid={`${context}-contact-${channel.id}-placeholder`} title={channel.placeholder}>
          {channel.label}: details coming soon
        </span>
      ),
    )
  }
</div>
